CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE STUDENTS(ID VARCHAR(40) NOT NULL PRIMARY KEY,NAME VARCHAR(120),EMAIL VARCHAR(180),PHONE VARCHAR(40),DEPARTMENT VARCHAR(120),SEMESTER INTEGER,TYPE VARCHAR(30),STATUS VARCHAR(30),ADMISSION_DATE VARCHAR(30),ATTENDANCE DOUBLE,CREATED_AT TIMESTAMP,UPDATED_AT TIMESTAMP)
CREATE MEMORY TABLE SUBJECTS(CODE VARCHAR(30) NOT NULL PRIMARY KEY,NAME VARCHAR(120),CREDITS INTEGER)
CREATE MEMORY TABLE CLASSES(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(120),DEPARTMENT VARCHAR(120),SEMESTER INTEGER,ROOM VARCHAR(60),CAPACITY INTEGER)
CREATE MEMORY TABLE MARKS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,STUDENT_ID VARCHAR(40),SUBJECT_CODE VARCHAR(30),MARK DOUBLE,UPDATED_AT TIMESTAMP)
CREATE MEMORY TABLE ATTENDANCE(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,STUDENT_ID VARCHAR(40),SUBJECT_CODE VARCHAR(30),PRESENT BOOLEAN,RECORDED_AT TIMESTAMP)
CREATE MEMORY TABLE AUDIT_LOGS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TIMESTAMP TIMESTAMP,ACTOR VARCHAR(80),ACTION VARCHAR(120),DETAILS VARCHAR(1000))
CREATE MEMORY TABLE SYSTEM_EVENTS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TIMESTAMP TIMESTAMP,TYPE VARCHAR(100),STUDENT_ID VARCHAR(40),PAYLOAD VARCHAR(2000))
ALTER TABLE CLASSES ALTER COLUMN ID RESTART WITH 3
ALTER TABLE MARKS ALTER COLUMN ID RESTART WITH 9
ALTER TABLE ATTENDANCE ALTER COLUMN ID RESTART WITH 0
ALTER TABLE AUDIT_LOGS ALTER COLUMN ID RESTART WITH 0
ALTER TABLE SYSTEM_EVENTS ALTER COLUMN ID RESTART WITH 0
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
SET SCHEMA PUBLIC
